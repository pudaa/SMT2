/* 深色主题样式 */
#mainFrame {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 15px;
}

#titleBar {
    background-color: #2b2b2b;
    border-bottom: 1px solid #404040;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

#navPanel {
    background-color: #2b2b2b;
    border-right: 1px solid #404040;
    border-bottom-left-radius: 15px;
}

#contentPanel {
    background-color: #2b2b2b;
    border-bottom-right-radius: 15px;
}

#applyContainer {
    background-color: transparent;
}

#themeButton {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 15px;
    padding: 15px;
    color: #ffffff;
}

#themeButton:hover {
    background-color: #404040;
}

/* Excel转Word视图样式 */
ExcelToWordView {
    background-color: #2b2b2b;
    font-family: "Microsoft YaHei", Arial, sans-serif;
    font-size: 12px;
}

ExcelToWordView QListWidget {
    border: 1px solid #555;
    border-radius: 4px;
    padding: 2px;
    background-color: #2b2b2b;
}

ExcelToWordView QListWidget::item {
    padding: 4px;
    border-bottom: 1px solid #444;
    color: #ffffff;
}

ExcelToWordView QListWidget::item:hover {
    background-color: #3a3a3a;
}


ExcelToWordView QListWidget::item:selected {
    color: white;                 
}

ExcelToWordView QListWidget::item:selected:hover {
    color: white;      
}

ExcelToWordView QLineEdit, 
ExcelToWordView QTextEdit {
    border: 1px solid #555;
    border-radius: 4px;
    padding: 5px;
    background-color: #2b2b2b;
    color: #ffffff;
}

ExcelToWordView QLineEdit:focus, 
ExcelToWordView QTextEdit:focus {
    border: 1px solid #0078d4;
}

ExcelToWordView QComboBox {
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #2b2b2b;
    color: #ffffff;
    min-height: 20px;
}

ExcelToWordView QComboBox::drop-down {
    border: none;
}

ExcelToWordView QPushButton {
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
}

ExcelToWordView QPushButton:hover {
    background-color: #106ebe;
}

ExcelToWordView QPushButton:pressed {
    background-color: #005a9e;
}

ExcelToWordView QScrollArea {
    border: 1px solid #444;
    border-radius: 4px;
    background-color: #2b2b2b;
}

ExcelToWordView QScrollBar:vertical {
    border: none;
    background-color: #3a3a3a;
    width: 12px;
    margin: 0px;
}

ExcelToWordView QScrollBar::handle:vertical {
    background-color: #555;
    border-radius: 6px;
    min-height: 20px;
}

ExcelToWordView QScrollBar::handle:vertical:hover {
    background-color: #666;
}

ExcelToWordView QLabel {
    color: #ffffff;
}

#dropAreaLabel {
    color: #aaa;
    font-style: italic;
    background-color: #333;
    border: 2px dashed #555;
    border-radius: 6px;
    padding: 20px;
}

/* 预览区样式与列容器（合并重复定义） */
#previewWidget {
    background-color: #31363a;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.02);
    padding: 6px;
}

#columnWidget QLabel#columnTitle {
    font-weight: bold;
    background-color: #3a3f44;
    padding: 4px;
    border-radius: 3px;
}

#columnItemsContainer {
    background-color: transparent;
}

/* 预览项标签 */
#previewItemLabel {
    background-color: #3a3f44;
    color: #ffffff;
    padding: 3px;
    border-radius: 3px;
}

/* 复合内容 */
#compositeContentLabel {
    background-color: #34393d;
    color: #ffffff;
    padding: 5px;
    border-radius: 4px;
    border: 1px solid #444c52;
}

/* 卡片间距和间距 - 深色（保守样式以避免 QSS 解析问题） */
#columnWidget {
    padding: 8px;
    border: 1px solid #40484f;
    border-radius: 8px;
    background-color: #282c2f;
}

#columnWidget:hover {
    border: 1px solid #5a6b78;
    background-color: #272b2e;
}

/* 列内项 hover 和间距（使用通配符子选择器） */
#columnItemsContainer * {
    margin-right: 6px;
}

#columnItemsContainer *:hover, #previewItemLabel:hover {
    background-color: #42484c;
}


#columnWidget QPushButton { 
    background: #2b2b2b; 
    border: none; 
    color: #cfcfcf;
}

#columnWidget QPushButton:hover {
    background-color: #5a6b78;
}

/* 分割器样式 */
QSplitter::handle {
    background-color: #404040;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* 导航列表项样式 */
QListWidget#navList {
    background-color: #2b2b2b;
    border: none;
    outline: none;
    border-radius: 10px;
}

QListWidget#navList::item {
    background-color: #2b2b2b;
    border: none;
    padding: 8px 16px;
    margin: 2px 0;
    border-radius: 8px;
    color: #ffffff;
}

QListWidget#navList::item:selected {
    background-color: #404040;
    color: #ffffff;
}

QListWidget#navList::item:hover {
    background-color: #404040;
}

/* 首页视图样式 */
#homeView {
    background-color: #2b2b2b;
    border-radius: 10px;
}

#scrollWidget {
    background-color: #2b2b2b;
    border-radius: 10px;
}

/* 设置视图样式 */
#settingView {
    background-color: #2b2b2b;
    border-radius: 10px;
}

QGroupBox {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 10px;
    color: #ffffff;
}

QGroupBox::title {
    /* subcontrol-origin: margin; */
    left: 10px;
    padding: 0 5px 0 5px;
    color: #ffffff;
}

QLineEdit {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 5px;
    padding: 5px;
    color: #ffffff;
}

QPushButton {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 5px;
    padding: 5px 10px;
    color: #ffffff;
}

QPushButton:hover {
    background-color: #404040;
}

QToolButton {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 5px;
    padding: 2px;
    color: #ffffff;
}

QToolButton:hover {
    background-color: #404040;
}

QLabel {
    background-color: transparent;
    color: #ffffff;
}

/* Switch开关样式 */
Switch {
    background-color: #555555;
    border-radius: 10px;
    padding: 2px;
    min-width: 40px;
    max-width: 40px;
    min-height: 24px;
    max-height: 24px;
}

Switch::groove {
    background-color: #555555;
    border-radius: 10px;
    width: 36px;
    height: 20px;
}

Switch::handle {
    background-color: #cccccc;
    border-radius: 9px;
    width: 18px;
    height: 18px;
    margin: 1px;
    border: 1px solid #aaaaaa;
}

Switch:checked {
    background-color: #0078d4;
}

Switch:checked::groove {
    background-color: #0078d4;
}